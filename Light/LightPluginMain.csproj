<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light</AssemblyName>
        <RootNamespace>Light</RootNamespace>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Light In The Dark - Among Us Mod</Description>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' != ''">$(LIGHT_AMONGUS)</AmongUs>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' == ''">F:\AU\暗中辉0.0.0.1</AmongUs>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />
    </ItemGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('android'))">
		<DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
	</PropertyGroup>
    <ItemGroup>
      <Folder Include="Components\" />
      <Folder Include="Resources\News\" />
      <Folder Include="Systems\" />
    </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\LightAPI\LightInDark.csproj" />
	</ItemGroup>
    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LibDlls Include="..\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
            <Reference Include="@(_LibDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>
	<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
		<DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>
	<Target Name="CustomCopyToOutput" AfterTargets="Build">
		<PropertyGroup>
			<CustomOutDir>$(ProjectDir)..\Output\</CustomOutDir>
		</PropertyGroup>
		<MakeDir Directories="$(CustomOutDir)" Condition="!Exists('$(CustomOutDir)')" />

		<!-- ==================================================================
		     生成主插件时，往 Output\ 放**两个要部署的文件**：

		       Light.dll         主插件（本项目产物）
		       LightInDark.dll   API  —— ⚠️ 程序集名是 **LightInDark**，
		                               "LightAPI" 只是它的项目/文件夹名
		                               （..\LightAPI\LightInDark.csproj）

		     LightInDark.dll 取两条路，先真产物再兜底：
		       ① @(ReferencePath) 里程序集名为 LightInDark 的那条 —— ProjectReference
		          解析出来的真实产物路径（通常是 LightAPI\bin\...\LightInDark.dll）
		       ② ..\Libs\LightInDark.dll —— LightInDark.csproj 的 CopyToLibs 目标
		          每次构建都会把产物同步到那儿，所以那份总是最新的

		     不用 @(ReferenceCopyLocalPaths) 过滤：..\Libs\*.dll 那个通配会把
		     Libs\LightInDark.dll 以 <Private>false</Private> 引进来，
		     和 ProjectReference 打架，导致它不一定出现在那个集合里。
		     ================================================================== -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomOutDir)" />

		<ItemGroup>
			<_ApiDllFromRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'LightInDark'" />
		</ItemGroup>
		<Copy SourceFiles="@(_ApiDllFromRef)" DestinationFolder="$(CustomOutDir)"
		      Condition="'@(_ApiDllFromRef)' != ''"
		      SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(ProjectDir)..\Libs\LightInDark.dll" DestinationFolder="$(CustomOutDir)"
		      Condition="Exists('$(ProjectDir)..\Libs\LightInDark.dll')"
		      SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CustomOutDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<Message Importance="high" Text="[Output] Light.dll + LightInDark.dll → $(CustomOutDir)" />
	</Target>
</Project>